---
import { localize, type Language } from '../../portfolio';
import '../../styles/experience.css';

interface Props {
  language: Language;
}
const { language } = Astro.props;
const { experience, copy } = localize(language);
const english = language === 'en';
---
<section id="experience" class="experience-demos" aria-labelledby="experience-title">
  <div class="experience-stage wrap" data-layout="compare">
    <header class="experience-stage-heading">
      <h2 id="experience-title">{copy.experience}</h2>
    </header>

    <div class="experience-content">
      <ol class="experience-records" id="experience-records">
        {experience.map((role, index) => (
          <li class="experience-entry" id={'experience-role-' + index}>
            <p class="experience-period">{role.period}</p>
            <h3>{role.title}</h3>
            <p class="experience-org">{role.organization}</p>
            <p class="experience-description">{role.description}</p>
          </li>
        ))}
      </ol>
      {!experience.length && <p>{english ? 'No experience listed yet.' : 'Belum ada pengalaman.'}</p>}
    </div>
  </div>
</section>
