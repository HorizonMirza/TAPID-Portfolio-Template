---
import { localize, type Language } from './portfolio';
import { demoTheme, selectedHome } from './home-demos';
import './styles/home-demos.css';
import './styles/home-demos-theme.css';

interface Props { language: Language; preview?: boolean }
const { language, preview = false } = Astro.props;
const { copy, p, projects, skills } = localize(language);
const project = projects[0];
---
<div class="home-demo-stage" id={preview ? "home-demo-stage" : undefined} data-demo-stage={preview ? "" : undefined}
     data-theme={demoTheme} data-design={selectedHome.id} data-art={selectedHome.art}>
  <div class="home-demo-title">
    <p>{p.role}</p>
    <h1 id="portfolio-home-title">{p.name}</h1>
  </div>
  <div class="home-demo-copy">
    <p class="home-demo-headline">{p.headline}</p>
    <p class="home-demo-intro">{p.intro}</p>
    <a class="action home-demo-action" href={projects.length ? '#projects' : '#about'}>
      {projects.length ? copy.viewProjects : copy.about}
    </a>
  </div>
  {p.portrait && <figure class="home-demo-portrait">
    <img src={p.portrait.src} alt={p.portrait.alt} fetchpriority="high" />
  </figure>}
  <div class="home-demo-detail">
    <p class="home-demo-location">{p.location}</p>
    {project && <a href="#projects">{project.title}</a>}
    {skills[0] && <p>{skills[0]}</p>}
  </div>
</div>
