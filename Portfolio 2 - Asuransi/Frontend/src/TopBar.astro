---
import Controls from './Controls.astro';
import MobileNav from './MobileNav.astro';
import { localize, type Language } from './portfolio';
import './styles/topbar.css';

interface Props { language: Language }
const { language } = Astro.props;
const { copy, p, nav } = localize(language);
const topBar = {"layout": "compact", "skin": "float", "mark": "circle", "links": "pill", "motion": "snap", "symbol": ""};
---
<header class="tapbar tapbar-asuransi" data-layout={topBar.layout} data-skin={topBar.skin}
        data-mark={topBar.mark} data-links={topBar.links}>
  <div class="tapbar-inner" data-motion={topBar.motion}>
    <a class="tapbar-brand" href="#home">
      <span class="tapbar-symbol" aria-hidden="true">{topBar.symbol || p.initials}</span>
      <strong>{p.name}</strong>
    </a>
    <nav class="tapbar-desktop" aria-label={copy.navigation}>
      {nav.map((item) => <a href={item.href}>{item.name}</a>)}
    </nav>
    <div class="tapbar-tools">
      <MobileNav label={copy.navigation} menu={copy.menu} links={nav} />
      <Controls language={language} />
    </div>
  </div>
</header>
