---
import { localize, type Language } from '../../portfolio';
import '../../styles/projects.css';
import '../../styles/project-image.css';

interface Props { language: Language }
const { language } = Astro.props;
const { copy, projects } = localize(language);
const english = language === 'en';
const enlarge = english ? 'Enlarge image' : 'Perbesar gambar';
const close = english ? 'Close' : 'Tutup';
---
<section id="projects" class="project-previews" data-project-section data-theme="asuransi" aria-labelledby="work-title">
  <div id="project-preview-stage" class="project-preview-stage wrap" data-layout="gallery">
    <header class="project-preview-title">
      <h2 id="work-title">{copy.projects}</h2>
    </header>
    <div class="project-preview-showcase">
      <ol class="project-preview-items" id="project-preview-items">
        {projects.map((project, index) => (
          <li id={`project-preview-item-${index}`} data-project-card>
            <article class="project-preview-card" data-project-image-card={project.image ? "" : undefined}>
              {project.image
                ? <figure class="project-preview-art" data-loading-media>
                    <a class="project-image-open" href={project.image.src} data-project-image={project.title}
                       aria-label={`${enlarge}: ${project.title}`}>
                      <img src={project.image.src} alt={project.image.alt} loading="lazy" />
                    </a>
                  </figure>
                : <div class="project-preview-art project-preview-graphic" data-graphic={index % 3} aria-hidden="true">
                    <span></span><span></span><span></span>
                  </div>}
              <div class="project-preview-copy">
                <p class="project-preview-category">{project.category}</p>
                <h3>{project.title}</h3>
                <p class="project-preview-description">{project.description}</p>
                {project.href && <a class="project-link" href={project.href} aria-label={`${copy.viewProject}: ${project.title}`}>{copy.viewProject}</a>}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
    {!projects.length && <p>{english ? 'No projects yet.' : 'Belum ada proyek.'}</p>}
  </div>
  {projects.some(({ image }) => image) && <dialog class="project-image-dialog" data-project-image-dialog
          aria-labelledby="project-image-heading">
    <div class="project-image-panel">
      <header>
        <h2 id="project-image-heading" data-project-image-heading></h2>
        <form method="dialog"><button type="submit" aria-label={close} autofocus>×</button></form>
      </header>
      <img data-project-image-full alt="" />
      <p data-project-image-error role="status" hidden>
        {english ? 'The image could not be loaded.' : 'Gambar tidak berhasil dimuat.'}
      </p>
    </div>
  </dialog>}
</section>

<script is:inline>
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    const target = event.target;
    let link = target.closest?.('a[data-project-image]');
    if (!link) {
      const card = target.closest?.('[data-project-image-card]');
      if (!card || target.closest('a, button, summary, input, select, textarea, label, [contenteditable]')) return;

      // Dragging to select project text must not open the image.
      const selection = window.getSelection();
      if (selection && !selection.isCollapsed && card.contains(selection.anchorNode)) return;

      link = card.querySelector('a[data-project-image]');
    }
    if (!link) return;
    const dialog = link.closest('[data-project-section]')?.querySelector('[data-project-image-dialog]');
    if (!dialog || typeof dialog.showModal !== 'function') return;

    event.preventDefault();
    if (dialog.open || dialog.hasAttribute('data-closing')) return;
    const image = dialog.querySelector('[data-project-image-full]');
    const message = dialog.querySelector('[data-project-image-error]');
    const events = new AbortController();
    const { signal } = events;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const motion = typeof dialog.animate === 'function' ? window.tapidMotion?.preview : undefined;
    let animation;
    dialog.querySelector('[data-project-image-heading]').textContent = link.dataset.projectImage;
    image.alt = link.querySelector('img').alt;
    image.hidden = false;
    message.hidden = true;
    image.addEventListener('error', () => {
      image.hidden = true;
      message.hidden = false;
    }, { once: true, signal });
    const closePreview = async () => {
      if (dialog.hasAttribute('data-closing')) return;
      dialog.setAttribute('data-closing', '');
      animation?.stop();
      const fade = dialog.hasAttribute('data-motion-preview') && !reduced.matches
        ? motion(dialog, false)
        : dialog.getAnimations?.().find((animation) => animation.transitionProperty === 'opacity');
      animation = dialog.hasAttribute('data-motion-preview') ? fade : undefined;
      if (fade) await Promise.allSettled([fade.finished]);
      if (!signal.aborted && dialog.open) dialog.close();
    };
    const interceptClose = (event) => {
      event.preventDefault();
      void closePreview();
    };
    dialog.addEventListener('submit', interceptClose, { signal });
    dialog.addEventListener('cancel', interceptClose, { signal });
    dialog.addEventListener('click', (click) => {
      if (click.target === dialog) void closePreview();
    }, { signal });
    dialog.addEventListener('close', () => {
      events.abort();
      if (dialog.hasAttribute('data-motion-preview')) {
        animation?.cancel();
        dialog.removeAttribute('data-motion-preview');
        dialog.style.removeProperty('opacity');
        dialog.style.removeProperty('transform');
      }
      dialog.removeAttribute('data-closing');
      image.removeAttribute('src');
      if (link.isConnected) link.focus({ preventScroll: true });
    }, { once: true });
    reduced.addEventListener('change', () => {
      if (!reduced.matches || !dialog.open) return;
      if (dialog.hasAttribute('data-closing')) {
        dialog.close();
      } else if (animation) {
        animation.cancel();
        animation = undefined;
        dialog.style.removeProperty('opacity');
        dialog.style.removeProperty('transform');
      }
    }, { signal });
    if (motion && !reduced.matches) dialog.setAttribute('data-motion-preview', '');
    dialog.showModal();
    if (dialog.hasAttribute('data-motion-preview')) animation = motion(dialog, true);
    image.src = link.href;
  });
</script>
