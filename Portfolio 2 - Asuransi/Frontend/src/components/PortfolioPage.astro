---
import Frame from './layout/Frame.astro';
import TopBar from './layout/TopBar.astro';
import HomeHero from './sections/HomeHero.astro';
import AboutSection from './sections/AboutSection.astro';
import ProjectSection from './sections/ProjectSection.astro';
import SkillSection from './sections/SkillSection.astro';
import ExperienceSection from './sections/ExperienceSection.astro';
import CvLink from './sections/CvLink.astro';
import ContactFooter from './sections/ContactFooter.astro';
import { localize, type Language } from '../portfolio';
interface Props {
  language: Language;
}
const { language } = Astro.props;
const { copy, p, projects, skills, experience, contact } = localize(language);
---
<Frame language={language} skip={copy.skip}>
  <TopBar language={language} />
  <main id="main" tabindex="-1">
    {p.portrait ? (
      <section id="home" aria-labelledby="portfolio-home-title">
        <HomeHero language={language} />
      </section>
    ) : (
      <section id="home" class="risk-hero split-hero">
        <div class="risk-intro hero-copy">
          <p class="home-demo-role">{p.role}</p><h1>{p.name}</h1>
          <p class="risk-line">{p.headline}</p><p class="copy">{p.intro}</p>
          <CvLink href={p.cvUrl} />
          <a class="action" href={contact.channels.length ? '#contact' : '#about'}>{contact.channels.length ? copy.viewContact : copy.about}</a>
        </div>
      </section>
    )}
    {<AboutSection language={language} />}
    {projects.length > 0 && <ProjectSection language={language} />}
    {skills.length > 0 && <SkillSection language={language} />}
    {experience.length > 0 && <ExperienceSection language={language} />}
  </main>
  <ContactFooter language={language} name={p.name} theme="asuransi" channels={contact.channels} layout="split" />
</Frame>
