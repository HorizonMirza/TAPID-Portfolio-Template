---
import PortfolioPage from '../PortfolioPage.astro';
import HomeDemos from '../HomeDemos.astro';
import AboutDemos from '../AboutDemos.astro';
import ProjectSection from '../ProjectSection.astro';
import SkillSection from '../SkillSection.astro';
import ExperienceSection from '../ExperienceSection.astro';
import { portfolio, type Language } from '../portfolio';

export function getStaticPaths() {
  return portfolio.settings.demo ? [
    { params: { demo: 'demo-beranda' }, props: { language: 'id' as const, section: 'home' as const } },
    { params: { demo: 'en/demo-beranda' }, props: { language: 'en' as const, section: 'home' as const } },
    { params: { demo: 'demo-tentang' }, props: { language: 'id' as const, section: 'about' as const } },
    { params: { demo: 'en/demo-tentang' }, props: { language: 'en' as const, section: 'about' as const } },
    { params: { demo: 'demo-proyek' }, props: { language: 'id' as const, section: 'projects' as const } },
    { params: { demo: 'en/demo-proyek' }, props: { language: 'en' as const, section: 'projects' as const } },
    { params: { demo: 'demo-keahlian' }, props: { language: 'id' as const, section: 'skills' as const } },
    { params: { demo: 'en/demo-keahlian' }, props: { language: 'en' as const, section: 'skills' as const } },
    { params: { demo: 'demo-pengalaman' }, props: { language: 'id' as const, section: 'experience' as const } },
    { params: { demo: 'en/demo-pengalaman' }, props: { language: 'en' as const, section: 'experience' as const } },
  ] : [];
}

interface Props { language: Language; section: 'home' | 'about' | 'projects' | 'skills' | 'experience' }
const { language, section } = Astro.props;
---
{section === 'experience' ? (
  <PortfolioPage language={language}>
    <ExperienceSection slot="experience-preview" language={language} preview />
  </PortfolioPage>
) : section === 'skills' ? (
  <PortfolioPage language={language}>
    <SkillSection slot="skills-preview" language={language} preview />
  </PortfolioPage>
) : section === 'projects' ? (
  <PortfolioPage language={language}>
    <ProjectSection slot="projects-preview" language={language} preview />
  </PortfolioPage>
) : section === 'about' ? (
  <PortfolioPage language={language}>
    <AboutDemos slot="about-preview" language={language} />
  </PortfolioPage>
) : (
  <PortfolioPage language={language}>
    <HomeDemos slot="home" language={language} />
  </PortfolioPage>
)}
