---
import { localize, type Language } from './portfolio';
import { skillGroups, skillOptions, skillTheme } from './skill-demos';
import './styles/skill-demos.css';

interface Props { language: Language }
const { language } = Astro.props;
const { skills, copy } = localize(language);
const english = language === 'en';
const first = skillOptions[0];
const classified = new Set(skillGroups.flatMap((group) => group.indexes));
const groups = skillGroups.map((group) => ({
  title: group.name[language],
  skills: group.indexes.flatMap((index) => skills[index] ? [skills[index]] : []),
})).filter((group) => group.skills.length);
const others = skills.filter((_, index) => !classified.has(index));
if (others.length) groups.push({ title: english ? 'Other skills' : 'Keahlian lain', skills: others });
const pickerTitle = english ? 'Skill layout demos' : 'Demo tata letak Keahlian';
---
<section id="skills" class="skill-previews" data-skill-demos data-theme={skillTheme} aria-labelledby="skill-preview-title">
  <div class="skill-picker wrap">
    <div class="skill-picker-head">
      <h2 id="skill-picker-title">{pickerTitle}</h2>
      <a href={english ? '/en/#skills' : '/#skills'}>{english ? 'Back to portfolio' : 'Kembali ke portofolio'}</a>
    </div>
    <div class="skill-options" role="group" aria-labelledby="skill-picker-title">
      {skillOptions.map(({ id, layout, name }) => (
        <button type="button" data-skill-choice={id} data-layout={layout} aria-pressed={id === first.id}
                aria-controls="skill-preview-stage" aria-label={id + ' ' + name[language]}>
          <span>{id}</span><strong>{name[language]}</strong>
        </button>
      ))}
    </div>
    <p class="skill-selection" aria-live="polite">{first.name[language]}</p>
  </div>

  <div id="skill-preview-stage" class="skill-stage wrap" data-layout={first.layout}>
    <header class="skill-stage-head">
      <h2 id="skill-preview-title">{copy.skills}</h2>
      <div class="skill-scroll-buttons" role="group" aria-label={english ? 'Scroll skill groups' : 'Geser kelompok keahlian'} hidden>
        <button type="button" data-skill-scroll="-1" aria-controls="skill-group-list" aria-label={english ? 'Previous group' : 'Kelompok sebelumnya'}>←</button>
        <button type="button" data-skill-scroll="1" aria-controls="skill-group-list" aria-label={english ? 'Next group' : 'Kelompok berikutnya'}>→</button>
      </div>
    </header>

    <div class="skill-content">
      <ul class="skill-list" data-skill-flat>
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
      <div class="skill-group-view" data-skill-group-view hidden>
        <div class="skill-tabs" role="group" aria-label={english ? 'Choose a skill group' : 'Pilih kelompok keahlian'} hidden>
          {groups.map((group, index) => (
            <button type="button" data-skill-tab={index} aria-controls={'skill-group-' + index} aria-pressed={index === 0}>
              {group.title}
            </button>
          ))}
        </div>
        <div class="skill-groups" id="skill-group-list">
          {groups.map((group, index) => (
            <section class="skill-group" id={'skill-group-' + index} aria-labelledby={'skill-group-title-' + index}>
              <h3 id={'skill-group-title-' + index}>{group.title}</h3>
              <ul>{group.skills.map((skill) => <li>{skill}</li>)}</ul>
            </section>
          ))}
        </div>
      </div>
      <div class="skill-accordion" hidden>
        {groups.map((group, index) => (
          <details name="skill-demo-group" open={index === 0}>
            <summary>{group.title}</summary>
            <ul>{group.skills.map((skill) => <li>{skill}</li>)}</ul>
          </details>
        ))}
      </div>
      {!skills.length && <p>{english ? 'No skills yet.' : 'Belum ada keahlian.'}</p>}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    let controller;
    let activeGroup = 0;
    const groupedLayouts = new Set(['clusters', 'matrix', 'tabs', 'carousel', 'atlas']);

    function initializeSkills() {
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;
      const root = document.querySelector('[data-skill-demos]');
      if (!root) return;

      const choices = [...root.querySelectorAll('[data-skill-choice]')];
      const stage = root.querySelector('.skill-stage');
      const content = root.querySelector('.skill-content');
      const selection = root.querySelector('.skill-selection');
      const list = root.querySelector('[data-skill-flat]');
      const groupView = root.querySelector('[data-skill-group-view]');
      const groups = root.querySelector('.skill-groups');
      const panels = [...groups.children];
      const tabs = root.querySelector('.skill-tabs');
      const tabButtons = [...tabs.querySelectorAll('button')];
      const accordion = root.querySelector('.skill-accordion');
      const scrollButtons = root.querySelector('.skill-scroll-buttons');
      const [previous, next] = scrollButtons.querySelectorAll('button');
      const languageLink = document.querySelector('.tapbar a.language');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let animation;

      function updateScrollButtons() {
        if (scrollButtons.hidden) return;
        previous.disabled = groups.scrollLeft < 2;
        next.disabled = groups.scrollLeft + groups.clientWidth >= groups.scrollWidth - 2;
      }

      function showGroup(index) {
        activeGroup = index;
        for (const [position, panel] of panels.entries()) panel.hidden = stage.dataset.layout === 'tabs' && position !== index;
        for (const [position, button] of tabButtons.entries()) button.setAttribute('aria-pressed', String(position === index));
      }

      function select(choice, animate) {
        const layout = choice.dataset.layout;
        stage.dataset.layout = layout;
        choices.forEach((button) => button.setAttribute('aria-pressed', String(button === choice)));
        selection.textContent = choice.querySelector('strong').textContent;
        groupView.hidden = !groupedLayouts.has(layout);
        accordion.hidden = layout !== 'accordion';
        list.hidden = !groupView.hidden || !accordion.hidden;
        tabs.hidden = layout !== 'tabs' || panels.length < 2;
        scrollButtons.hidden = layout !== 'carousel' || panels.length < 2;
        showGroup(animate ? 0 : activeGroup);
        if (!scrollButtons.hidden) {
          groups.scrollLeft = 0;
          updateScrollButtons();
        }

        if (languageLink) {
          const url = new URL(languageLink.href);
          url.searchParams.set('pilihan', choice.dataset.skillChoice);
          languageLink.href = url.href;
        }
        animation?.cancel();
        if (animate && !reducedMotion.matches && content.animate) {
          animation = content.animate([
            { opacity: .5, transform: 'translateY(5px)' },
            { opacity: 1, transform: 'none' },
          ], { duration: 200, easing: 'ease-out' });
        }
      }

      function selectFromAddress() {
        const id = new URLSearchParams(location.search).get('pilihan');
        select(choices.find((choice) => choice.dataset.skillChoice === id) ?? choices[0], false);
      }

      for (const choice of choices) {
        choice.addEventListener('click', () => {
          if (choice.getAttribute('aria-pressed') === 'true') return;
          const address = new URL(location.href);
          address.searchParams.set('pilihan', choice.dataset.skillChoice);
          try { history.replaceState(history.state, '', address.href); } catch {}
          select(choice, true);
        }, { signal });
      }
      for (const button of tabButtons) {
        button.addEventListener('click', () => showGroup(Number(button.dataset.skillTab)), { signal });
      }
      for (const button of [previous, next]) {
        button.addEventListener('click', () => {
          const step = panels[0].offsetWidth + parseFloat(getComputedStyle(groups).columnGap);
          groups.scrollBy({ left: step * Number(button.dataset.skillScroll), behavior: reducedMotion.matches ? 'instant' : 'smooth' });
        }, { signal });
      }
      groups.addEventListener('scroll', updateScrollButtons, { passive: true, signal });
      window.addEventListener('resize', updateScrollButtons, { signal });
      window.addEventListener('popstate', selectFromAddress, { signal });
      selectFromAddress();
    }

    initializeSkills();
    document.addEventListener('tapid:language-change', initializeSkills);
  })();
</script>
