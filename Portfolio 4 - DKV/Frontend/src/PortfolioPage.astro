---
import Frame from './Frame.astro';
import TopBar from './TopBar.astro';
import HomeHero from './HomeHero.astro';
import AboutSection from './AboutSection.astro';
import CvLink from './CvLink.astro';
import { localize, type Language } from './portfolio';
interface Props { language: Language }
const { language } = Astro.props;
const previewHome = Astro.slots.has('home');
const previewAbout = Astro.slots.has('about-preview');
const previewPath = previewAbout ? 'demo-tentang/' : previewHome ? 'demo-beranda/' : undefined;
const languageHref = previewPath ? `${language === 'id' ? '/en/' : '/'}${previewPath}` : undefined;
const { copy, p, projects, skills, experience, contact, demo } = localize(language);
const heroImage = projects.find((project) => project.image)?.image;
---
<Frame language={language} skip={copy.skip} previewPath={previewPath}>
  <TopBar language={language} languageHref={languageHref} />
  <main id="main" tabindex="-1">
    {previewAbout && <slot name="about-preview" />}
    {previewHome ? <slot name="home" /> : p.portrait ? (
      <section id="home" aria-labelledby="portfolio-home-title">
        <HomeHero language={language} />
      </section>
    ) : (
      <section id="home" class="studio-hero">
        <div class="wrap studio-title">
          <div>
            <p class="home-demo-role">{p.role}</p>
            <h1>{p.name}</h1>
          </div>
          <p>{p.location}</p>
        </div>
        <div class="studio-split split-hero">
          <div class="studio-intro hero-copy">
            <p class="studio-line">{p.headline}</p><p>{p.intro}</p>
            <CvLink href={p.cvUrl} demo={demo} />
          </div>
          {heroImage ? <figure class="studio-portrait hero-media"><img class="profile-image" src={heroImage.src} alt={heroImage.alt} fetchpriority="high" /></figure> :
            <div class="paper-fold hero-media" aria-hidden="true"><span></span></div>}
        </div>
      </section>
    )}
    {!previewAbout && <AboutSection language={language} />}
    {projects.length > 0 && <section id="projects" class="wrap studio-work" aria-labelledby="work-title">
      <h2 id="work-title">{copy.projects}</h2>
      <div class="gallery">
        {projects.map((project) => <article>
          {project.image ? <img class="project-image" src={project.image.src} alt={project.image.alt} loading="lazy" /> :
            <div class="poster" aria-hidden="true"><i></i><span>{project.title}</span></div>}
          <div class="caption"><h3>{project.title}</h3><p class="section-label">{project.category}</p></div>
          <p class="copy">{project.description}</p>
          {project.href && <a class="project-link" href={project.href} aria-label={`${copy.viewProject}: ${project.title}`}>{copy.viewProject}</a>}
        </article>)}
      </div>
    </section>}
    <div class="wrap studio-details">
      {skills.length > 0 && <section id="skills" aria-labelledby="skills-title"><h2 id="skills-title">{copy.skills}</h2>
        <ul>{skills.map((skill) => <li>{skill}</li>)}</ul></section>}
      {experience.length > 0 && <section id="experience" aria-labelledby="experience-title"><h2 id="experience-title">{copy.experience}</h2>
        <ol>{experience.map((job) => <li><div><h3>{job.title}</h3><p>{job.organization}</p></div><p class="section-label">{job.period}</p><p class="copy">{job.description}</p></li>)}</ol>
      </section>}
    </div>
  </main>
  <footer class="studio-footer wrap">
    {contact.links.length > 0 && <section id="contact" aria-labelledby="contact-title">
      <p class="section-label">{copy.contact}</p><h2 id="contact-title">{contact.headline}</h2><p class="copy">{contact.description}</p>
      <div class="contact-links">{contact.links.map(({ href, label }) => <a href={href}>{label}</a>)}</div>
    </section>}
    <div class="studio-footer-bar"><a href="#home">{copy.top}</a><p>{demo ? copy.demo : p.name}</p></div>
  </footer>
</Frame>
