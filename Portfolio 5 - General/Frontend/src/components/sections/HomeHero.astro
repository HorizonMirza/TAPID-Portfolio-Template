---
import { localize, type Language } from '../../portfolio';
import CvLink from './CvLink.astro';
import '../../styles/home.css';
import '../../styles/home-theme.css';

interface Props { language: Language }
const { language } = Astro.props;
const { p } = localize(language);
---
<div class="home-demo-stage" data-theme="general" data-design="01" data-art="frame">
  <div class="home-demo-content">
    <div class="home-demo-title">
      <p class="home-demo-role">{p.role}</p>
      <h1 id="portfolio-home-title">{p.name}</h1>
    </div>
    <div class="home-demo-copy">
      <p class="home-demo-headline">{p.headline}</p>
      <p class="home-demo-intro">{p.intro}</p>
      <CvLink href={p.cvUrl} />
    </div>
  </div>
  {p.portrait && <figure class="home-demo-portrait" data-loading-media>
    <img src={p.portrait.src} alt={p.portrait.alt} fetchpriority="high" />
  </figure>}
</div>
