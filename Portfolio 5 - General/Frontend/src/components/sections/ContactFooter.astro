---
import type { FooterChannel } from '../../footer-channels';
import type { Language } from '../../portfolio';
import '../../styles/footer-demos.css';

interface Props {
  language: Language;
  name: string;
  theme: string;
  channels: FooterChannel[];
  layout: string;
  preview?: boolean;
}
const { language, name, theme, channels, layout, preview = false } = Astro.props;
const english = language === 'en';
const year = new Date().getUTCFullYear();
const hasContact = preview || channels.length > 0;
const logos = {
  whatsapp: 'whatsapp.svg',
  linkedin: 'linkedin.png',
  github: 'github.svg',
  instagram: 'instagram.svg',
  resume: 'drive.png',
  linktree: 'linktree.png',
};
---
<footer id={hasContact ? 'contact' : undefined} class="contact-footer" data-theme={theme} data-footer-layout={layout}
        aria-labelledby={hasContact ? 'contact-footer-title' : undefined}>
  <div class="contact-footer-inner">
    {hasContact && <>
      <div class="contact-footer-heading">
        <h2 id="contact-footer-title">{english ? 'Get in touch' : 'Hubungi saya'}</h2>
      </div>
      <ul class="footer-channels">
        {channels.map(({ kind, label, detail, href, enabled = true, sample }) => {
          const example = Boolean(sample);
          const Card = example ? 'div' : 'a';
          const external = !example && href.startsWith('https:');
          return (
          <li data-footer-channel={kind} hidden={!enabled}>
            <Card class="footer-channel" data-sample={example ? '' : undefined} href={example ? undefined : href}
                  target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
              <span class="footer-channel-icon" aria-hidden="true">
                {kind === 'email' || kind === 'website' ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                    <path d={kind === 'email'
                      ? 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z M3 7l9 6 9-6'
                      : 'M10 13.5a4 4 0 0 0 5.7 0l4-4a4 4 0 0 0-5.7-5.7l-2.2 2.2M14 10.5a4 4 0 0 0-5.7 0l-4 4a4 4 0 0 0 5.7 5.7l2.2-2.2'} />
                  </svg>
                ) : (
                  <img class={kind === 'github' || kind === 'instagram' ? 'footer-logo-on-light' : undefined}
                       src={'/brands/' + logos[kind]} alt="" width="24" height="24" decoding="async" />
                )}
                {(kind === 'github' || kind === 'instagram') && (
                  <img class="footer-logo-on-dark" src={'/brands/' + kind + '-dark.svg'} alt="" width="24" height="24" decoding="async" />
                )}
              </span>
              <span class="footer-channel-copy">
                <strong>{label}</strong>
                {detail && <span>{detail}</span>}
              </span>
              {!example && <span class="footer-channel-arrow" aria-hidden="true">↗</span>}
            </Card>
          </li>
          );
        })}
      </ul>
    </>}
    {preview && <p class="footer-empty" data-footer-empty hidden={channels.some(({ enabled = true }) => enabled)}>
      {english ? 'Select a contact channel to preview it here.' : 'Centang kanal kontak untuk menampilkannya di sini.'}
    </p>}
    <div class="contact-footer-signoff">
      <small>© {year} {name}</small>
    </div>
  </div>
</footer>
