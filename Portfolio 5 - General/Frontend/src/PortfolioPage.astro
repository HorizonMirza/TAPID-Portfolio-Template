---
import Frame from './Frame.astro';
import TopBar from './TopBar.astro';
import HomeHero from './HomeHero.astro';
import AboutSection from './AboutSection.astro';
import ProjectSection from './ProjectSection.astro';
import SkillSection from './SkillSection.astro';
import CvLink from './CvLink.astro';
import { localize, type Language } from './portfolio';
interface Props { language: Language }
const { language } = Astro.props;
const previewHome = Astro.slots.has('home');
const previewAbout = Astro.slots.has('about-preview');
const previewProjects = Astro.slots.has('projects-preview');
const previewSkills = Astro.slots.has('skills-preview');
const previewPath = previewSkills ? 'demo-keahlian/' : previewProjects ? 'demo-proyek/' : previewAbout ? 'demo-tentang/' : previewHome ? 'demo-beranda/' : undefined;
const languageHref = previewPath ? `${language === 'id' ? '/en/' : '/'}${previewPath}` : undefined;
const { copy, p, projects, skills, experience, contact, demo } = localize(language);
---
<Frame language={language} skip={copy.skip} previewPath={previewPath}>
  <TopBar language={language} languageHref={languageHref} />
  <main id="main" tabindex="-1">
    {previewSkills && <slot name="skills-preview" />}
    {previewProjects && <slot name="projects-preview" />}
    {previewAbout && <slot name="about-preview" />}
    {previewHome ? <slot name="home" /> : p.portrait ? (
      <section id="home" aria-labelledby="portfolio-home-title">
        <HomeHero language={language} />
      </section>
    ) : (
      <section id="home" class="folio-hero split-hero">
        <div class="hero-copy folio-intro">
          <p class="home-demo-role">{p.role}</p><h1>{p.name}</h1>
          <p class="folio-line">{p.headline}</p><p class="copy">{p.intro}</p>
          <CvLink href={p.cvUrl} demo={demo} />
        </div>
              </section>
    )}
    {!previewAbout && <AboutSection language={language} />}
    {!previewProjects && projects.length > 0 && <ProjectSection language={language} />}
    {!previewSkills && skills.length > 0 && <SkillSection language={language} />}
    {experience.length > 0 && <section id="experience" class="wrap folio-experience" aria-labelledby="experience-title">
      <h2 id="experience-title">{copy.experience}</h2><ol>{experience.map((job) => <li>
        <p class="section-label">{job.period}</p><div><h3>{job.title}</h3><p>{job.organization}</p><p class="copy">{job.description}</p></div>
      </li>)}</ol>
    </section>}
  </main>
  <footer class="folio-footer">
    {contact.links.length > 0 && <section id="contact" class="wrap" aria-labelledby="contact-title">
      <p class="section-label">{copy.contact}</p><h2 id="contact-title">{contact.headline}</h2><p class="copy">{contact.description}</p>
      <div class="contact-links">{contact.links.map(({ href, label }) => <a href={href}>{label}</a>)}</div>
    </section>}
    <div class="wrap folio-colophon"><p>{demo ? copy.demo : p.name}</p><a href="#home">{copy.top}</a></div>
  </footer>
</Frame>
