---
import Controls from './Controls.astro';
import MobileNav from './MobileNav.astro';
import { localize, type Language } from './portfolio';
import './styles/topbar.css';

interface Props { language: Language; languageHref?: string; portfolioHref?: string }
const { language, languageHref, portfolioHref } = Astro.props;
const { copy, p, nav } = localize(language);
const links = portfolioHref ? nav.map((item) => ({
  ...item,
  href: item.href === '#contact' ? item.href : portfolioHref + item.href,
})) : nav;
---
<header class="tapbar tapbar-general" data-nav="capsule" data-skin="float" data-links="pill">
  <div class="tapbar-inner" data-motion="rise">
    <a class="tapbar-brand" href={(portfolioHref ?? "") + "#home"}>
      <strong>{p.name}</strong>
    </a>
    <nav class="tapbar-desktop" aria-label={copy.navigation}>
      {links.map((item) => <a href={item.href}>{item.name}</a>)}
    </nav>
    <div class="tapbar-tools">
      <MobileNav label={copy.navigation} menu={copy.menu} links={links} />
      <Controls language={language} languageHref={languageHref} />
    </div>
  </div>
</header>
