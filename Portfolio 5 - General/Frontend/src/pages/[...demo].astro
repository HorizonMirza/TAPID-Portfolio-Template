---
import PortfolioPage from '../components/PortfolioPage.astro';
import FooterDemoPage from '../demos/FooterDemoPage.astro';
import { demoSlugs, type DemoSection } from '../demos/routes';
import { portfolio, type Language } from '../portfolio';

export function getStaticPaths() {
  if (!portfolio.settings.demo) return [];

  const sections = Object.keys(demoSlugs) as DemoSection[];
  return sections.flatMap((section) => (['id', 'en'] as const).map((language) => ({
    params: { demo: (language === 'en' ? 'en/' : '') + demoSlugs[section] },
    props: { language, section },
  })));
}

interface Props {
  language: Language;
  section: DemoSection;
}
const { language, section } = Astro.props;
---
{section === 'footer'
  ? <FooterDemoPage language={language} />
  : <PortfolioPage language={language} preview={section} />}
