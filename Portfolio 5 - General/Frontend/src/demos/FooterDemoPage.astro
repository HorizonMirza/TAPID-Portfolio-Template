---
import Frame from '../components/layout/Frame.astro';
import TopBar from '../components/layout/TopBar.astro';
import ContactFooter from '../components/sections/ContactFooter.astro';
import { footerLayouts } from './footer-demos';
import { demoSlugs } from './routes';
import type { FooterChannel } from '../footer-channels';
import { localize, type Language } from '../portfolio';

interface Props {
  language: Language;
}
const { language } = Astro.props;
const english = language === 'en';
const { copy, p, contact } = localize(language);
const theme = 'general';
const path = english ? '/en/' : '/';
const previewPath = demoSlugs.footer + '/';
const languageHref = (english ? '/' : '/en/') + previewPath;
const channels: FooterChannel[] = [
  ...contact.channels,
  { kind: 'linktree', label: 'Linktree', detail: p.name, href: 'https://linktr.ee/', enabled: false, sample: true },
];
---
<Frame language={language} skip={copy.skip} previewPath={previewPath}>
  <TopBar language={language} languageHref={languageHref} portfolioHref={path} />
  <main id="main" class="footer-demo-controls" tabindex="-1" data-footer-demo>
    <div class="footer-demo-inner">
      <div class="footer-demo-heading">
        <h1>{english ? 'Footer demos' : 'Demo Footer'}</h1>
        <a href={path + '#contact'}>{english ? 'Back to portfolio' : 'Kembali ke portofolio'}</a>
      </div>

      <div class="footer-demo-options" role="group" aria-label={english ? 'Footer layouts' : 'Desain footer'}>
        {footerLayouts.map((option, index) => (
          <button type="button" data-footer-choice={option.number} data-layout={option.layout}
                  aria-pressed={index === 0} aria-controls="contact">
            <span>{option.number}</span>
            <strong>{option[language]}</strong>
          </button>
        ))}
      </div>

      <fieldset class="footer-demo-channels">
        <legend>{english ? 'Contact channels' : 'Kanal kontak'}</legend>
        <div class="footer-demo-checks">
          {channels.map(({ kind, label, enabled }) => (
            <label><input type="checkbox" value={kind} data-footer-toggle data-default={String(enabled ?? true)} checked={enabled ?? true} aria-controls="contact" /> {label}</label>
          ))}
        </div>
      </fieldset>
    </div>
  </main>
  <ContactFooter language={language} name={p.name} theme={theme} channels={channels} layout={footerLayouts[0].layout} preview />

<script is:inline>
  (() => {
    let controller;

    function initializeFooterDemo() {
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;
      const controls = document.querySelector('[data-footer-demo]');
      if (!controls) return;

      const footer = document.querySelector('.contact-footer');
      const cards = [...footer.querySelectorAll('[data-footer-channel]')];
      const empty = footer.querySelector('[data-footer-empty]');
      const choices = [...controls.querySelectorAll('[data-footer-choice]')];
      const toggles = [...controls.querySelectorAll('[data-footer-toggle]')];
      const languageLink = document.querySelector('.tapbar a.language');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let animation;

      function updateLanguageLink(params) {
        if (!languageLink) return;
        const alternate = new URL(languageLink.href);
        for (const name of ['pilihan', 'kontak']) {
          if (params.has(name)) alternate.searchParams.set(name, params.get(name));
          else alternate.searchParams.delete(name);
        }
        languageLink.href = alternate.href;
      }

      function showLayout(choice, animate) {
        footer.dataset.footerLayout = choice.dataset.layout;
        choices.forEach((button) => button.setAttribute('aria-pressed', String(button === choice)));
        animation?.cancel();
        if (animate && !reducedMotion.matches && footer.animate) {
          animation = footer.animate(
            [{ opacity: .58, transform: 'translateY(5px)' }, { opacity: 1, transform: 'none' }],
            { duration: 185, easing: 'ease-out' },
          );
        }
      }

      function showChannels() {
        const enabled = new Set(toggles.filter((toggle) => toggle.checked).map((toggle) => toggle.value));
        for (const card of cards) card.hidden = !enabled.has(card.dataset.footerChannel);
        empty.hidden = enabled.size > 0;
      }

      function restore() {
        const params = new URLSearchParams(location.search);
        showLayout(choices.find((choice) => choice.dataset.footerChoice === params.get('pilihan')) ?? choices[0], false);
        const enabled = params.get('kontak')?.split(',');
        for (const toggle of toggles) {
          toggle.checked = enabled ? enabled.includes(toggle.value) : toggle.dataset.default === 'true';
        }
        showChannels();
        updateLanguageLink(params);
      }

      function save(name, value) {
        const address = new URL(location.href);
        address.searchParams.set(name, value);
        try { history.replaceState(history.state, '', address.href); } catch {}
        updateLanguageLink(address.searchParams);
      }

      for (const choice of choices) {
        choice.addEventListener('click', () => {
          if (choice.getAttribute('aria-pressed') === 'true') return;
          showLayout(choice, true);
          save('pilihan', choice.dataset.footerChoice);
        }, { signal });
      }
      for (const toggle of toggles) {
        toggle.addEventListener('change', () => {
          showChannels();
          save('kontak', toggles.filter((item) => item.checked).map((item) => item.value).join(','));
        }, { signal });
      }
      window.addEventListener('popstate', restore, { signal });
      restore();
    }

    initializeFooterDemo();
    document.addEventListener('tapid:language-change', initializeFooterDemo);
  })();
</script>
</Frame>
