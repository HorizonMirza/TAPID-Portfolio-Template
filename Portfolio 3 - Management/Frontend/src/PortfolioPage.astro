---
import Frame from './Frame.astro';
import TopBar from './TopBar.astro';
import HomeHero from './HomeHero.astro';
import AboutSection from './AboutSection.astro';
import CvLink from './CvLink.astro';
import { localize, type Language } from './portfolio';
interface Props { language: Language }
const { language } = Astro.props;
const previewHome = Astro.slots.has('home');
const previewAbout = Astro.slots.has('about-preview');
const previewProjects = Astro.slots.has('projects-preview');
const previewPath = previewProjects ? 'demo-proyek/' : previewAbout ? 'demo-tentang/' : previewHome ? 'demo-beranda/' : undefined;
const languageHref = previewPath ? `${language === 'id' ? '/en/' : '/'}${previewPath}` : undefined;
const { copy, p, projects, skills, experience, contact, demo } = localize(language);
---
<Frame language={language} skip={copy.skip} previewPath={previewPath}>
  <TopBar language={language} languageHref={languageHref} />
  <main id="main" tabindex="-1">
    {previewProjects && <slot name="projects-preview" />}
    {previewAbout && <slot name="about-preview" />}
    {previewHome ? <slot name="home" /> : p.portrait ? (
      <section id="home" aria-labelledby="portfolio-home-title">
        <HomeHero language={language} />
      </section>
    ) : (
      <section id="home" class="ops-hero split-hero">
        <div class="ops-statement hero-copy">
          <p class="home-demo-role">{p.role}</p><h1>{p.name}</h1><p class="ops-line">{p.headline}</p>
          <p class="ops-intro">{p.intro}</p>
          <CvLink href={p.cvUrl} demo={demo} />
        </div>
        <div class="ops-graphic" aria-hidden="true"><i></i><i></i><i></i></div>
      </section>
    )}
    {!previewAbout && <AboutSection language={language} />}
    {!previewProjects && projects.length > 0 && <section id="projects" class="wrap ops-projects" aria-labelledby="work-title">
      <h2 id="work-title">{copy.projects}</h2>
      <div class="project-board">
        {projects.map((project) => <article>
          <p class="section-label">{project.category}</p>
          {project.image && <img class="project-image" src={project.image.src} alt={project.image.alt} loading="lazy" />}
          <h3>{project.title}</h3><p class="copy">{project.description}</p>
          {project.href && <a class="project-link" href={project.href} aria-label={`${copy.viewProject}: ${project.title}`}>{copy.viewProject}</a>}
        </article>)}
      </div>
    </section>}
    {skills.length > 0 && <section id="skills" class="wrap ops-skills" aria-labelledby="skills-title">
      <h2 id="skills-title">{copy.skills}</h2><ul>{skills.map((skill) => <li>{skill}</li>)}</ul>
    </section>}
    {experience.length > 0 && <section id="experience" class="wrap ops-experience" aria-labelledby="experience-title">
      <h2 id="experience-title">{copy.experience}</h2>
      <ol>{experience.map((job) => <li><p class="section-label">{job.period}</p><h3>{job.title}<small>{job.organization}</small></h3><p class="copy">{job.description}</p></li>)}</ol>
    </section>}
  </main>
  <footer class="ops-footer">
    {contact.links.length > 0 && <section id="contact" class="wrap" aria-labelledby="contact-title">
      <div><p class="section-label">{copy.contact}</p><h2 id="contact-title">{contact.headline}</h2><p>{contact.description}</p></div>
      <div class="contact-links">{contact.links.map(({ href, label }) => <a href={href}>{label}</a>)}</div>
    </section>}
    <div class="wrap ops-footer-note"><p>{demo ? copy.demo : p.name}</p><a href="#home">{copy.top}</a></div>
  </footer>
</Frame>
