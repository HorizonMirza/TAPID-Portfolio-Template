---
import { localize, type Language } from '../../portfolio';
import '../../styles/skills.css';

interface Props { language: Language }
const { language } = Astro.props;
const { skills, copy } = localize(language);
const english = language === 'en';
---
<section id="skills" class="skill-previews" data-theme="management" aria-labelledby="skills-title">
  <div id="skill-preview-stage" class="skill-stage wrap" data-layout="mosaic">
    <header class="skill-stage-head">
      <h2 id="skills-title">{copy.skills}</h2>
    </header>

    <div class="skill-content">
      <ul class="skill-list" data-skill-flat>
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
      {!skills.length && <p>{english ? 'No skills yet.' : 'Belum ada keahlian.'}</p>}
    </div>
  </div>
</section>
