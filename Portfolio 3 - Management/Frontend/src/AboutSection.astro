---
import { localize, type Language } from './portfolio';
import { aboutTheme, selectedAbout } from './about-demos';
import './styles/about-demos.css';

interface Props { language: Language }
const { language } = Astro.props;
const { about, p, copy } = localize(language);
const preview = Astro.slots.has('picker');
const english = language === 'en';
const format = new Intl.NumberFormat(english ? 'en-US' : 'id-ID', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const education = about.education;
const facts = [
  { key: 'university', label: english ? 'University' : 'Universitas', value: education?.university },
  { key: 'major', label: english ? 'Major' : 'Jurusan', value: education?.major?.[language] },
  { key: 'specialization', label: english ? 'Specialization' : 'Spesialisasi', value: education?.specialization?.[language] },
  {
    key: 'gpa',
    label: 'GPA',
    value: education?.gpa && `${format.format(education.gpa.value)} / ${format.format(education.gpa.scale)}`,
  },
].filter((fact) => fact.value);
---
<section id="about" class:list={['about-section', { 'about-demos': preview }]} data-theme={aboutTheme}
         data-about-demos={preview ? "" : undefined} aria-labelledby={preview ? "about-demo-heading" : "about-title"}>
  <slot name="picker" />
  <div class="about-stage" id={preview ? "about-demo-stage" : undefined} data-about-stage={preview ? "" : undefined}
       data-layout={selectedAbout.layout}>
    <div class="about-intro">
      <div class="about-heading">
        <p class="about-kicker">{copy.about} · {p.name}</p>
        <h2 id="about-title">{about.headline}</h2>
      </div>
      <p class="about-summary">{about.description}</p>
    </div>
    {facts.length > 0 && <dl class="about-facts">
      {facts.map(({ key, label, value }) => <div class="about-fact" data-fact={key}>
        <dt>{label}</dt>
        <dd>{value}</dd>
      </div>)}
    </dl>}
  </div>
</section>
