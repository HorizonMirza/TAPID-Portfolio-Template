---
// Serialize the compiled function so preferences apply before the page paints.
function applyVisitorPreferences(): void {
  const root = document.documentElement;
  const base = '/TAPID-Portfolio-Templates/';
  const themes = ['teknologi', 'asuransi', 'management', 'dkv', 'general', 'finance'];
  const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : '';
  const [theme, section] = path.split('/');
  if (themes.includes(theme)) root.dataset.theme = theme;
  if (section === 'id' || theme === 'id') {
    root.lang = 'id';
    document.title = '404 · Halaman tidak ditemukan';
  }
  try {
    const mode = localStorage.getItem('tapid-color-mode');
    if (mode === 'light' || mode === 'dark') root.dataset.mode = mode;
  } catch {}
}
---
<!doctype html>
<html lang="en" data-theme="general" data-mode="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="noindex">
  <title>404 · Page not found</title>
  <script is:inline set:html={`(${applyVisitorPreferences.toString()})();`}></script>
  <style is:inline>
    @font-face {
      font-family: Technology;
      src: url('/TAPID-Portfolio-Templates/teknologi/fonts/theme.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: Insurance;
      src: url('/TAPID-Portfolio-Templates/asuransi/fonts/theme.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: Management;
      src: url('/TAPID-Portfolio-Templates/management/fonts/theme.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: DKV;
      src: url('/TAPID-Portfolio-Templates/dkv/fonts/theme.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: General;
      src: url('/TAPID-Portfolio-Templates/general/fonts/theme.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: Finance;
      src: url('/TAPID-Portfolio-Templates/finance/fonts/theme.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }

    :root {
      color-scheme: light dark;
      --page: light-dark(var(--wash), var(--midnight));
      --text: light-dark(var(--ink), var(--wash));
      --signal: light-dark(var(--accent), var(--glow));
      --button-text: light-dark(var(--on-accent), var(--midnight));
    }
    :root[data-mode="light"] { color-scheme: light; }
    :root[data-mode="dark"] { color-scheme: dark; }
    [data-theme="teknologi"] {
      --accent: #2859e8; --wash: #f5f7ff; --ink: #101c37; --midnight: #0b1429; --glow: #90b3ff;
      --on-accent: #fff; --display: Technology, sans-serif; --radius: .45rem;
    }
    [data-theme="asuransi"] {
      --accent: #32a85a; --wash: #f1faf3; --ink: #13251a; --midnight: #13271c; --glow: #8ee6a6;
      --on-accent: #0a1b0f; --display: Insurance, sans-serif; --radius: 1.35rem;
    }
    [data-theme="management"] {
      --accent: #ffdf24; --wash: #fffdf0; --ink: #241b00; --midnight: #231c0c; --glow: #ffe55c;
      --on-accent: #241b00; --display: Management, sans-serif; --radius: 0;
    }
    [data-theme="dkv"] {
      --accent: #ff5148; --wash: #fff2ed; --ink: #291714; --midnight: #281514; --glow: #ff8277;
      --on-accent: #240907; --display: DKV, sans-serif; --radius: 0;
    }
    [data-theme="general"] {
      --accent: #111; --wash: #fff; --ink: #111; --midnight: #090909; --glow: #eee;
      --on-accent: #fff; --display: General, Georgia, serif; --radius: 0;
    }
    [data-theme="finance"] {
      --accent: #bd48f9; --wash: #faf3ff; --ink: #23112f; --midnight: #170d20; --glow: #d889ff;
      --on-accent: #16091c; --display: Finance, Georgia, serif; --radius: .35rem;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--text);
      background: radial-gradient(ellipse at center, color-mix(in srgb, var(--signal) 12%, var(--page)), transparent 68%), var(--page);
      font: 1rem/1.55 system-ui, sans-serif;
    }
    main {
      min-height: 100vh;
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: clamp(1rem, 4vw, 3.5rem);
      text-align: center;
    }
    .digits {
      margin: 0 0 clamp(1rem, 3vw, 2rem);
      padding-inline-end: .015em;
      font: 760 clamp(6rem, 29vw, 17rem)/.85 var(--display);
      letter-spacing: -.015em;
      font-variant-numeric: lining-nums tabular-nums;
    }
    .digits span { color: color-mix(in srgb, var(--signal) 76%, var(--text)); }
    h1 {
      font: 700 clamp(1.75rem, 4.3vw, 3.25rem)/1.08 var(--display);
      letter-spacing: -.04em;
      margin: 0 0 .65rem;
      text-wrap: balance;
    }
    p { margin: 0 0 1.15rem; }
    a {
      display: inline-flex;
      align-items: center;
      gap: .6rem;
      padding: .68rem .95rem;
      border-radius: var(--radius);
      color: var(--button-text);
      background: var(--signal);
      font-size: .9rem;
      font-weight: 700;
      text-decoration: none;
    }
    a:hover { text-decoration: underline; }
    a:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
    html[lang="id"] .english, html[lang="en"] .indonesian { display: none; }
  </style>
</head>
<body>
  <main>
    <div>
      <div class="digits" aria-hidden="true">4<span>0</span>4</div>
      <div class="indonesian">
        <h1>Halaman tidak ditemukan</h1>
        <p>Halaman ini mungkin telah dipindah atau alamatnya keliru.</p>
        <a href="/TAPID-Portfolio-Templates/">Lihat semua portofolio <span aria-hidden="true">↗</span></a>
      </div>
      <div class="english">
        <h1>Page not found</h1>
        <p>This page may have moved, or the address may be incorrect.</p>
        <a href="/TAPID-Portfolio-Templates/">View all portfolios <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </main>
</body>
</html>
