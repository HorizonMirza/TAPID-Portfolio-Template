---
import type { Language } from './portfolio';
import { aboutDemos, selectedAbout } from './about-demos';
import AboutSection from './AboutSection.astro';

interface Props { language: Language }
const { language } = Astro.props;
const english = language === 'en';
const heading = english ? 'About layout demos' : 'Demo Tentang';
---
<AboutSection language={language}>
  <div class="about-picker" slot="picker">
    <div class="about-picker-header">
      <h2 id="about-demo-heading">{heading}</h2>
      <a href={english ? '/en/#about' : '/#about'}>{english ? 'Portfolio' : 'Portofolio'}</a>
    </div>
    <div class="about-choices" role="group" aria-labelledby="about-demo-heading">
      {aboutDemos.map((choice) => (
        <button type="button" class="about-choice" data-about-choice={choice.id} data-layout={choice.layout}
                aria-controls="about-demo-stage" aria-pressed={choice.id === selectedAbout.id} aria-label={`${choice.id} ${choice.name}`}>
          <span>{choice.id}</span><strong class="about-choice-name">{choice.name}</strong>
        </button>
      ))}
    </div>
    <p class="about-selection" aria-live="polite" aria-atomic="true">
      <strong data-about-selection>{selectedAbout.id} · {selectedAbout.name}</strong>
      <span data-about-description>{selectedAbout.caption[language]}</span>
    </p>
    <div hidden data-about-captions={JSON.stringify(aboutDemos.map((choice) => choice.caption[language]))}></div>
  </div>
</AboutSection>

<script is:inline>
  (() => {
    let controller;
    function initializePicker() {
      controller?.abort();
      controller = new AbortController();
      const root = document.querySelector('[data-about-demos]');
      if (!root) return;
      const buttons = Array.from(root.querySelectorAll('[data-about-choice]'));
      const stage = root.querySelector('[data-about-stage]');
      const selection = root.querySelector('[data-about-selection]');
      const description = root.querySelector('[data-about-description]');
      const captions = JSON.parse(root.querySelector('[data-about-captions]').dataset.aboutCaptions);
      const lang = document.querySelector('.tapbar a.language');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const initial = buttons.find((button) => button.getAttribute('aria-pressed') === 'true') ?? buttons[0];
      let active = initial;
      let animation;

      function select(button, animate) {
        active.setAttribute('aria-pressed', 'false');
        button.setAttribute('aria-pressed', 'true');
        active = button;
        stage.dataset.layout = button.dataset.layout;
        selection.textContent = button.dataset.aboutChoice + ' · ' + button.querySelector('.about-choice-name').textContent;
        description.textContent = captions[buttons.indexOf(button)];
        if (lang) {
          const counterpart = new URL(lang.href);
          counterpart.searchParams.set('pilihan', button.dataset.aboutChoice);
          lang.href = counterpart.href;
        }
        animation?.cancel();
        if (animate && !reducedMotion.matches && stage.animate) {
          animation = stage.animate(
            [{ opacity: .48, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }],
            { duration: 230, easing: 'ease-out' },
          );
        }
      }

      function selectFromAddress() {
        const id = new URLSearchParams(location.search).get('pilihan');
        select(buttons.find((button) => button.dataset.aboutChoice === id) ?? initial, false);
      }

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const url = new URL(location.href);
          url.searchParams.set('pilihan', button.dataset.aboutChoice);
          url.hash = '';
          try { history.replaceState(history.state, '', url.href); } catch {}
          if (active !== button) select(button, true);
        });
      }
      window.addEventListener('popstate', selectFromAddress, { signal: controller.signal });
      selectFromAddress();
    }
    initializePicker();
    document.addEventListener('tapid:language-change', initializePicker);
  })();
</script>
