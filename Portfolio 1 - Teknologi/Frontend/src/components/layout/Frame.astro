---
import { portfolio, type Language } from '../../portfolio';
import '../../styles/base.css';
import '../../styles/font.css';
import '../../styles/theme.css';
import '../../styles/motion.css';

interface Props { language: Language; skip: string; previewPath?: string }
const { language, skip, previewPath: path = '' } = Astro.props;
const { profile, settings } = portfolio;
const pageTitle = `${profile.name} | ${profile.role[language]}`;
const productionHost = import.meta.env.VERCEL_PROJECT_PRODUCTION_URL;
const siteAddress = import.meta.env.TAPID_SITE_URL || (productionHost && `https://${productionHost}`);
const site = siteAddress ? new URL(siteAddress) : undefined;
if (site && (site.protocol !== 'https:' || site.username || site.password || site.search || site.hash)) {
  throw new Error('TAPID_SITE_URL must be a public HTTPS base URL.');
}
if (site && !site.pathname.endsWith('/')) site.pathname += '/';
const localizedPath = (locale: Language) => (locale === 'en' ? 'en/' : '') + path;
const alternateHref = (locale: Language) => site
  ? new URL(localizedPath(locale), site).href
  : '/' + localizedPath(locale);
const canonical = site && alternateHref(language);
const socialImage = site && profile.portrait
  ? new URL(profile.portrait.src.startsWith('/') ? profile.portrait.src.slice(1) : profile.portrait.src, site).href
  : undefined;
const contrastText = (hex: string) => {
  const channels = [1, 3, 5].map((offset) => parseInt(hex.slice(offset, offset + 2), 16) / 255);
  const linear = channels.map((value) => value <= .04045 ? value / 12.92 : ((value + .055) / 1.055) ** 2.4);
  const luminance = .2126 * linear[0] + .7152 * linear[1] + .0722 * linear[2];
  return luminance > .179 ? '#000000' : '#FFFFFF';
};
const customColors = Object.entries(settings.accent ?? {}).map(([mode, color]) =>
  `--custom-${mode}:${color};--custom-ink-${mode}:${contrastText(color)}`
).join(';');
---
<!doctype html>
<html lang={language} data-default-mode={settings.defaultMode} style={customColors || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={profile.introduction[language]} />
    <meta name="color-scheme" content="light dark" />
    {path && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="alternate" href={alternateHref('id')} hreflang="id" />
    <link rel="alternate" href={alternateHref('en')} hreflang="en" />
    {site && !path && <>
      <link rel="canonical" href={canonical} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonical} />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={profile.introduction[language]} />
      <meta property="og:locale" content={language === 'id' ? 'id_ID' : 'en_US'} />
      {socialImage && <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={profile.portrait?.alt[language]} />
      </>}
    </>}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const key = 'tapid-color-mode';
        const preference = window.matchMedia('(prefers-color-scheme: dark)');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let chosen;
        try { chosen = localStorage.getItem(key); } catch {}
        const apply = (mode) => {
          root.dataset.mode = mode;
          const button = document.querySelector('[data-mode-toggle]');
          if (!button) return;
          const dark = mode === 'dark';
          button.setAttribute('aria-pressed', String(dark));
          button.title = dark ? button.dataset.switchLight : button.dataset.switchDark;
        };
        const getMode = () => ['dark', 'light'].includes(chosen)
          ? chosen
          : root.dataset.defaultMode === 'system' ? (preference.matches ? 'dark' : 'light') : root.dataset.defaultMode;
        apply(getMode());
        let pageController;
        function initializeScrollReveal(signal) {
          if (signal.aborted || reducedMotion.matches || !document.body.hasAttribute('data-portfolio-page') ||
              !('IntersectionObserver' in window) || typeof Element.prototype.animate !== 'function') return;

          const targets = document.querySelectorAll(`
            #about .about-stage:not([data-layout="spread"]) .about-intro,
            #about .about-stage[data-layout="spread"] :is(.about-heading, .about-summary),
            #about .about-fact,
            #projects :is(.project-preview-title, .project-preview-tabs, [data-project-card], .project-preview-accordion > details),
            #skills :is(.skill-stage-head, .skill-list > li),
            #experience :is(.experience-stage-heading, .experience-entry, .experience-accordion > details),
            .contact-footer :is(.contact-footer-heading, .footer-channels > li, .contact-footer-signoff)
          `);
          const viewportHeight = root.clientHeight;
          const pending = new Set([...targets].filter((target) =>
            target.getClientRects().length > 0 && target.getBoundingClientRect().top >= viewportHeight
          ));
          if (!pending.size) return;

          const running = new Map();
          const show = (target) => {
            observer.unobserve(target);
            pending.delete(target);
            target.removeAttribute('data-scroll-reveal');
          };
          const observer = new IntersectionObserver((entries) => {
            for (const { isIntersecting, target } of entries) {
              if (!isIntersecting || !pending.has(target)) continue;
              show(target);
              if (reducedMotion.matches || target.matches(':focus-within')) continue;
              const done = () => running.delete(target);
              const animation = window.tapidMotion?.reveal(target, done) ?? target.animate([
                { opacity: 0, transform: 'translateY(8px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ], { duration: 260, easing: 'cubic-bezier(.22, 1, .36, 1)' });
              if (animation instanceof Animation) animation.onfinish = done;
              running.set(target, animation);
            }
          });

          for (const target of pending) {
            target.setAttribute('data-scroll-reveal', '');
            observer.observe(target);
          }
          document.addEventListener('focusin', (event) => {
            for (const target of pending) {
              if (target.contains(event.target)) show(target);
            }
            for (const [target, animation] of running) {
              if (!target.contains(event.target)) continue;
              animation.cancel();
              running.delete(target);
            }
          }, { signal });

          const reset = () => {
            observer.disconnect();
            for (const target of pending) target.removeAttribute('data-scroll-reveal');
            pending.clear();
            for (const animation of running.values()) animation.cancel();
            running.clear();
          };
          signal.addEventListener('abort', reset, { once: true });
          reducedMotion.addEventListener('change', () => {
            if (reducedMotion.matches) reset();
          }, { signal });
        }

        function initializePage() {
          pageController?.abort();
          pageController = new AbortController();
          const { signal } = pageController;
          apply(getMode());
          requestAnimationFrame(() => initializeScrollReveal(signal));
          for (const media of document.querySelectorAll('[data-loading-media]')) {
            const image = media.querySelector('img');
            if (!image || image.complete) continue;
            const finish = () => media.removeAttribute('data-skeleton');
            image.addEventListener('load', finish, { once: true, signal });
            image.addEventListener('error', finish, { once: true, signal });
            media.setAttribute('data-skeleton', '');
          }
          const topbar = document.querySelector('.tapbar');
          if (topbar) {
            root.setAttribute('data-section-navigation', '');
            const links = [...document.querySelectorAll('.tapbar-desktop a[href^="#"], .mobile-nav a[href^="#"]')];
            const sections = new Map();
            for (const link of links) {
              const section = document.getElementById(link.hash.slice(1));
              if (section) sections.set(link.hash, section);
            }

            let activeSection;
            let cancelScroll;
            let scrollFrame;
            let arrivalAnimation;
            let landing;
            const markSection = (hash) => {
              if (hash === activeSection) return;
              activeSection = hash;
              for (const link of links) {
                if (link.hash === hash) link.setAttribute('aria-current', 'location');
                else link.removeAttribute('aria-current');
              }
            };
            const updateSection = () => {
              const viewport = root.clientHeight;
              const topbarHeight = topbar.offsetHeight;
              const readingLine = topbarHeight + Math.max(24, (viewport - topbarHeight) * .22);
              const atBottom = window.scrollY > 0 && window.scrollY + root.clientHeight >= root.scrollHeight - 2;
              if (landing && Math.abs(window.scrollY - landing.y) > 2) landing = undefined;
              let current = landing?.hash ?? '#home';
              if (!landing) {
                let currentTop = -Infinity;
                for (const [hash, section] of sections) {
                  const top = section.getBoundingClientRect().top;
                  if ((atBottom || top <= readingLine) && (top > currentTop || (top === currentTop && hash === activeSection))) {
                    current = hash;
                    currentTop = top;
                  }
                }
              }
              markSection(current);
              const section = sections.get(current);
              const box = section?.getBoundingClientRect();
              const remaining = root.scrollHeight - viewport - window.scrollY;
              const distance = box ? Math.max(0, topbarHeight + 12 - box.top) : 0;
              const travel = box ? Math.max(1, Math.min(box.height, remaining + distance)) : 1;
              const progress = Math.min(1, distance / travel);
              topbar.style.setProperty('--section-progress', atBottom ? '1' : String(progress));
            };
            const sectionScrollTop = (target) => {
              const startInset = parseFloat(getComputedStyle(root).scrollPaddingBlockStart) || 0;
              const targetMargin = parseFloat(getComputedStyle(target).scrollMarginBlockStart) || 0;
              const targetPosition = window.scrollY + target.getBoundingClientRect().top - startInset - targetMargin;
              return Math.max(0, Math.min(targetPosition, root.scrollHeight - root.clientHeight));
            };
            const stopNavigation = () => {
              cancelScroll?.();
              cancelScroll = undefined;
            };
            const navigateToSection = (hash, target) => {
              stopNavigation();
              arrivalAnimation?.cancel();
              const start = window.scrollY;
              const distance = sectionScrollTop(target) - start;
              const finish = () => {
                cancelScroll = undefined;
                window.scrollTo({ top: sectionScrollTop(target), behavior: 'instant' });
                landing = { hash, y: window.scrollY };
                updateSection();
                if (!reducedMotion.matches && Math.abs(distance) > 2 && typeof target.animate === 'function') {
                  arrivalAnimation = target.animate([{ opacity: .92 }, { opacity: 1 }], {
                    duration: 140,
                    easing: 'ease-out',
                  });
                }
              };
              if (reducedMotion.matches || Math.abs(distance) <= 2) {
                finish();
                return;
              }

              const duration = Math.min(330, 165 + Math.abs(distance) * .055);
              if (window.tapidMotion) {
                cancelScroll = window.tapidMotion.scroll(start + distance, duration, finish);
                return;
              }

              const startedAt = performance.now();
              let frame;
              cancelScroll = () => window.cancelAnimationFrame(frame);
              const scroll = (now) => {
                const progress = Math.max(0, Math.min(1, (now - startedAt) / duration));
                if (progress === 1 || reducedMotion.matches) {
                  finish();
                  return;
                }
                const eased = progress * progress * (3 - 2 * progress);
                window.scrollTo({ top: start + distance * eased, behavior: 'instant' });
                frame = window.requestAnimationFrame(scroll);
              };
              frame = window.requestAnimationFrame(scroll);
            };
            const updateTopbarHeight = () => {
              root.style.setProperty('--topbar-height', `${Math.ceil(topbar.getBoundingClientRect().height)}px`);
              updateSection();
            };
            window.addEventListener('scroll', () => {
              if (!scrollFrame) {
                scrollFrame = window.requestAnimationFrame(() => {
                  scrollFrame = undefined;
                  updateSection();
                });
              }
            }, { passive: true, signal });
            window.addEventListener('wheel', stopNavigation, { passive: true, signal });
            window.addEventListener('touchstart', stopNavigation, { passive: true, signal });
            window.addEventListener('keydown', (event) => {
              if (['PageUp', 'PageDown', 'Home', 'End', 'ArrowUp', 'ArrowDown', ' '].includes(event.key)) {
                stopNavigation();
              }
            }, { signal });
            window.addEventListener('resize', updateTopbarHeight, { signal });
            const syncHistory = () => {
              stopNavigation();
              arrivalAnimation?.cancel();
              landing = undefined;
              updateSection();
            };
            window.addEventListener('popstate', syncHistory, { signal });
            window.addEventListener('hashchange', syncHistory, { signal });
            document.addEventListener('click', (event) => {
              if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
                  event.ctrlKey || event.shiftKey || event.altKey) return;
              const link = event.target.closest?.('a[href^="#"]');
              if (!link?.closest('.tapbar-desktop, .mobile-nav, .tapbar-brand')) return;
              const target = sections.get(link.hash);
              if (!target) return;

              if (location.hash !== link.hash) {
                try { history.pushState(history.state, '', link.hash); } catch { return; }
              }
              event.preventDefault();
              if (event.detail === 0) {
                if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
                target.focus({ preventScroll: true });
              }
              navigateToSection(link.hash, target);
            }, { signal });
            updateTopbarHeight();
            if ('ResizeObserver' in window) {
              const observer = new ResizeObserver(updateTopbarHeight);
              observer.observe(topbar);
              signal.addEventListener('abort', () => observer.disconnect(), { once: true });
            }
            signal.addEventListener('abort', () => {
              stopNavigation();
              window.cancelAnimationFrame(scrollFrame);
              arrivalAnimation?.cancel();
            }, { once: true });
          }
          document.querySelector('[data-mode-toggle]')?.addEventListener('click', () => {
            chosen = getMode() === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem(key, chosen); } catch {}
            if (!reducedMotion.matches && document.startViewTransition) {
              document.startViewTransition(() => apply(getMode()));
            } else {
              root.classList.toggle('mode-color-fade', !reducedMotion.matches);
              apply(chosen);
            }
          }, { signal });
        }

        const languageLink = () => document.querySelector('.tapbar a.language');
        const sections = () => [...document.querySelectorAll('.tapbar-desktop a[href^="#"]')];
        const activeHash = () => sections().find((link) => link.getAttribute('aria-current') === 'location')?.hash;
        const sectionFor = (hash) => hash && document.getElementById(hash.slice(1));
        const barBottom = () => document.querySelector('.tapbar')?.getBoundingClientRect().bottom ?? 0;
        const pages = new Map();
        let offlinePage;
        let initialLanguage;
        let pending;

        function readPage(source) {
          return {
            title: source.title,
            metadata: new Map([...source.head.querySelectorAll(
              'meta[name="description"], meta[property^="og:"], link[rel="canonical"]'
            )].map((element) => [
              element.getAttribute('name') || element.getAttribute('property') || element.rel,
              element.getAttribute('content') ?? element.getAttribute('href'),
            ])),
            body: source.body.cloneNode(true),
          };
        }

        function showLanguageError() {
          const previous = document.querySelector('[data-language-error]');
          if (previous) previous.remove();
          const notice = document.createElement('p');
          notice.dataset.languageError = '';
          notice.setAttribute('role', 'status');
          notice.textContent = root.lang === 'id' ? 'Bahasa gagal dimuat. Coba lagi.' : 'Language could not load. Try again.';
          document.body.append(notice);
        }

        async function readLanguage(target, language, signal) {
          if (pages.has(language)) return pages.get(language);

          let html;
          if (offlinePage?.language === language) {
            html = offlinePage.html;
          } else {
            const response = await fetch(target, { mode: 'same-origin', signal });
            if (!response.ok) throw new Error('Could not load language');
            html = await response.text();
          }
          const source = new DOMParser().parseFromString(html, 'text/html');
          if (source.documentElement.lang !== language || !source.querySelector('.tapbar') || !source.querySelector('#main')) {
            throw new Error('Unexpected language page');
          }
          const page = readPage(source);
          pages.set(language, page);
          return page;
        }

        function rememberReadingPosition() {
          const hash = activeHash() || location.hash;
          const section = sectionFor(hash);
          return {
            hash,
            offset: section ? barBottom() - section.getBoundingClientRect().top : 0,
            y: window.scrollY,
          };
        }

        function keepReadingPosition(position) {
          const section = sectionFor(position.hash);
          if (!section) {
            window.scrollTo({ top: position.y, behavior: 'instant' });
            return;
          }
          const box = section.getBoundingClientRect();
          const offset = Math.min(position.offset, Math.max(0, box.height - 24));
          window.scrollTo({ top: window.scrollY + box.top - barBottom() + offset, behavior: 'instant' });
        }

        async function changeLanguage(target, language, fromHistory = false) {
          if (language === root.lang || target.origin !== location.origin) return;
          pending?.abort();
          const controller = new AbortController();
          pending = controller;
          const link = languageLink();
          link?.setAttribute('aria-busy', 'true');

          try {
            const linkFocused = document.activeElement === link;
            const page = await readLanguage(target, language, controller.signal);
            if (controller.signal.aborted) return;
            const firstSection = document.querySelector('#main > section')?.id || 'home';
            const position = fromHistory
              ? { hash: target.hash || '#' + firstSection, offset: 0, y: 0 }
              : rememberReadingPosition();
            const address = offlinePage ? new URL(location.href) : new URL(target);
            if (offlinePage) {
              address.search = target.search;
              address.searchParams.set('lang', language);
            }
            if (!fromHistory) address.hash = position.hash === '#home' && position.y === 0 && !location.hash ? '' : position.hash;

            const update = () => {
              if (controller.signal.aborted) return;
              const body = page.body.cloneNode(true);
              body.querySelectorAll('script').forEach((script) => script.remove());
              if (!fromHistory) history.replaceState(history.state, '', address.href);
              root.lang = language;
              document.title = page.title;
              for (const element of document.head.querySelectorAll(
                'meta[name="description"], meta[property^="og:"], link[rel="canonical"]'
              )) {
                const name = element.getAttribute('name') || element.getAttribute('property') || element.rel;
                const value = page.metadata.get(name);
                if (value != null) element.setAttribute(element.tagName === 'LINK' ? 'href' : 'content', value);
              }
              const detailsState = new Map([...document.querySelectorAll('details[data-language-details]')]
                .map((panel) => [panel.dataset.languageDetails, panel.open]));
              for (const panel of body.querySelectorAll('details[data-language-details]')) {
                if (detailsState.has(panel.dataset.languageDetails)) {
                  panel.open = detailsState.get(panel.dataset.languageDetails);
                }
              }
              document.body.replaceWith(body);
              initializePage();
              document.dispatchEvent(new Event('tapid:language-change'));
              keepReadingPosition(position);
              if (linkFocused) languageLink()?.focus({ preventScroll: true });
            };

            if (!reducedMotion.matches && document.startViewTransition) {
              await document.startViewTransition(update).finished;
            } else {
              update();
              if (!reducedMotion.matches) {
                document.querySelector('#main')?.animate([{ opacity: .8 }, { opacity: 1 }], 180);
              }
            }
          } catch {
            if (!controller.signal.aborted) showLanguageError();
          } finally {
            if (pending === controller) {
              pending = undefined;
              link?.removeAttribute('aria-busy');
            }
          }
        }

        function languageFromAddress() {
          const url = new URL(location.href);
          if (offlinePage) {
            const language = url.searchParams.get('lang') || initialLanguage;
            return language === 'id' || language === 'en' ? language : initialLanguage;
          }
          return [...document.querySelectorAll('link[rel="alternate"][hreflang]')]
            .find((link) => new URL(link.href).pathname === url.pathname)?.hreflang;
        }

        document.addEventListener('DOMContentLoaded', () => {
          initialLanguage = root.lang;
          pages.set(initialLanguage, readPage(document));
          const source = document.getElementById('offline-portfolio-language');
          if (source) {
            offlinePage = JSON.parse(source.textContent);
            const mode = new URLSearchParams(location.search).get('mode');
            if (mode === 'light' || mode === 'dark') chosen = mode;
          }
          initializePage();
          const language = languageFromAddress();
          if (language && language !== initialLanguage) {
            void changeLanguage(new URL(location.href), language, true);
          }
        }, { once: true });

        document.addEventListener('click', (event) => {
          const link = event.target.closest?.('.tapbar a.language');
          if (!link || event.defaultPrevented || event.button !== 0 ||
              event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const target = new URL(link.href);
          if (target.origin !== location.origin) return;
          event.preventDefault();
          if (!pending) void changeLanguage(target, link.hreflang);
        });

        window.addEventListener('popstate', () => {
          const language = languageFromAddress();
          if (!language) return;
          if (language === root.lang) pending?.abort();
          else void changeLanguage(new URL(location.href), language, true);
        });
        preference.addEventListener('change', () => apply(getMode()));
      })();
    </script>
  </head>
  <body data-portfolio-page={path ? undefined : ''}>
    <a class="skip-link" href="#main">{skip}</a>
    <slot />
    <script>
      import { portfolioMotion } from '../../portfolio-motion';
      window.tapidMotion = portfolioMotion;
    </script>
  </body>
</html>
